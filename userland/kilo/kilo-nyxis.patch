--- a/kilo.c
+++ b/kilo.c
@@ -212,6 +212,9 @@
 /* Called at exit to avoid remaining in raw mode. */
 void editorAtExit(void) {
     disableRawMode(STDIN_FILENO);
+    /* Nyxis: the console has no alternate screen, so clear what the editor
+     * drew and put the cursor back at the top before the shell prompt. */
+    if (write(STDOUT_FILENO,"\x1b[0m\x1b[2J\x1b[H\x1b[?25h",17) == -1) {}
 }
 
 /* Raw mode: 1960 magic shit. */
@@ -830,12 +833,11 @@
 int editorSave(void) {
     int len;
     char *buf = editorRowsToString(&len);
-    int fd = open(E.filename,O_RDWR|O_CREAT,0644);
+    /* Nyxis: there is no ftruncate(2) (the kernel cannot shrink a file),
+     * so open with O_TRUNC instead and write the whole buffer at once. */
+    int fd = open(E.filename,O_WRONLY|O_CREAT|O_TRUNC,0644);
     if (fd == -1) goto writeerr;
 
-    /* Use truncate + a single write(2) call in order to make saving
-     * a bit safer, under the limits of what we can do in a small editor. */
-    if (ftruncate(fd,len) == -1) goto writeerr;
     if (write(fd,buf,len) != len) goto writeerr;
 
     close(fd);
@@ -1240,6 +1242,25 @@
     case ARROW_RIGHT:
         editorMoveCursor(c);
         break;
+    case HOME_KEY:
+        /* Nyxis: upstream decodes Home/End in editorReadKey() but never
+         * handled them here, so the key code fell through to
+         * editorInsertChar() and inserted a garbage byte. */
+        E.cx = 0;
+        E.coloff = 0;
+        break;
+    case END_KEY: {
+        int filerow = E.rowoff+E.cy;
+        int len = (filerow < E.numrows) ? E.row[filerow].size : 0;
+        if (len < E.screencols) {
+            E.coloff = 0;
+            E.cx = len;
+        } else {
+            E.coloff = len-E.screencols+1;
+            E.cx = E.screencols-1;
+        }
+        break;
+    }
     case CTRL_L: /* ctrl+l, clear screen */
         /* Just refresht the line as side effect. */
         break;
