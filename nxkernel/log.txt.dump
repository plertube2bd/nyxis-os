cp /usr/share/OVMF/OVMF_VARS_4M.fd ../out/OVMF_VARS.fd
env -i \
	PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
	DISPLAY=:1 \
	XDG_RUNTIME_DIR=/run/user/1000 \
	DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
	qemu-system-x86_64 \
		-machine q35 \
		-m 1024 -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd -drive if=pflash,format=raw,file=../out/OVMF_VARS.fd \
		-drive file=../out/esp.img,format=raw \
		-vga std \
		-serial stdio \
		-display gtk
